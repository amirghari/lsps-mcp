# ─── Production env (NEVER commit a populated copy) ──────────────────────
# Copy to your platform's environment-variable UI; do not bake into images.

# Required ----------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Pointer to your managed Postgres (Neon, Supabase, RDS, Pxxl-provided, …).
# Use SSL for any internet-facing connection: ?sslmode=require
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME?sslmode=require&schema=public

# 32+ byte random secret — generate with:  openssl rand -hex 32
JWT_SECRET=replace-me-please

# CORS — comma-separated list of allowed origins (frontend URL).
CORS_ORIGIN=https://your-frontend.example.app

# Recommended -------------------------------------------------------------
LOG_LEVEL=info
RESERVATION_TTL_SECONDS=300
EXPIRY_SWEEP_INTERVAL_SECONDS=15
JWT_EXPIRES_IN=24h
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# ─── Web (build-time only — Vite inlines these at build) ─────────────────
VITE_API_URL=https://your-api.example.app
